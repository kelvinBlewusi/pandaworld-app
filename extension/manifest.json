{
  "manifest_version": 3,
  "name": "PandaWorldAI - AI Jumia Listing Assistant",
  "version": "0.2.0",
  "description": "AI autofill for Jumia Vendor Center product listings — upload a photo, pick a category, and PandaWorld fills the form for you.",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://vendorcenter.jumia.com/*",
    "https://pandaworldai.site/*"
  ],
  "background": { "service_worker": "background/worker.js" },
  "action": { "default_title": "PandaWorld Autofill" },
  "side_panel": { "default_path": "panel/panel.html" },
  "content_scripts": [
    {
      "matches": ["https://vendorcenter.jumia.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vendorcenter.jumia.com/*"],
      "js": ["content/mainworld.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
