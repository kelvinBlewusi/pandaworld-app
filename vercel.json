{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev -p 3002",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/jumia-feeds",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reset-quotas",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/delete-stale-drafts",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron/check-category-freshness",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/embed-categories",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "25 0 * * *"
    }
  ]
}
